class Solution {
    public boolean isHappy(int n) {
        HashSet<Integer> set = new HashSet<>();
        
        while(n !=1){
            if(set.contains(n)){
                return false;
            }

            set.add(n);
            n = square(n);


        }

        return true;
    
    
    }

    public int square(int num){
        int sum=0;

        while(num>0){
            int temp = num%10;
            sum = sum+(temp*temp);
            num = num/10;

        }

        return sum;

        



    }

    
}
